# Configure no Netlify (Functions). Nunca versione valores reais.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# URL final do site: configure em Builds e Functions após o primeiro deploy.
SITE_URL=

# HAX Fotos — credenciais SOMENTE no painel Netlify (nunca no GitHub).
PUBLIC_SITE_URL=https://www.haxestudio.com.br
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=
# Alternativa legada, se necessário:
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=hax-fotos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MP_ACCESS_TOKEN=
# E-mail operacional autorizado pelo Mercado Pago (o cliente não informa e-mail).
# CONFIRME com o Mercado Pago se o uso deste endereço atende às regras para payer.email.
MP_PAYER_EMAIL=
MP_WEBHOOK_SECRET=
# Produção sempre exige live_mode=true. Não definir false em produção.
MP_REQUIRE_LIVE=true
