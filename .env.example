# Configure no Netlify (Functions). Nunca versione valores reais.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# URL final do site: configure em Builds e Functions após o primeiro deploy.
SITE_URL=

# HAX Fotos — credenciais SOMENTE no painel Netlify (nunca no GitHub).
PUBLIC_SITE_URL=https://www.haxestudio.com.br
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=
# Alternativa legada, se necessário:
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=hax-fotos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MP_ACCESS_TOKEN=
# O e-mail do PAGADOR é informado pelo próprio comprador no checkout.
MP_WEBHOOK_SECRET=
# O backend já exige pagamento live_mode=true antes de liberar originais.
# Em Deploy Preview, DEPLOY_PRIME_URL é fornecida pelo Netlify para o Webhook.
